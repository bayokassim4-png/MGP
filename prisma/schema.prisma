generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANIFIE
  EN_COURS
  CLOTURE
  ARCHIVE
}

enum UserStatus {
  ACTIF
  INACTIF
  INVITE
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

enum ApprovalLevel {
  CHEF_PROJET
  DAF
  DG
}

enum Quarter {
  Q1
  Q2
  Q3
  Q4
}
enum LogframeLevel {
  OBJECTIF_GLOBAL
  OBJECTIF_SPECIFIQUE
  RESULTAT
}

enum RiskStatus {
  OUVERT
  EN_COURS
  MAITRISE
  FERME
}

enum ProcurementMethod {
  AOI
  AON
  CONSULTANT
  GRE_A_GRE
  DEMANDE_COTATION
}

enum ProcurementStatus {
  PLANIFIE
  EN_COURS
  ATTRIBUE
  TERMINE
  ANNULE
}

model Organisation {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  country   String?
  sector    String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  projects  Project[]

  @@map("organisations")
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  organisationId  String        @db.Uuid
  email           String        @unique
  fullName        String?
  phone           String?
  status          UserStatus    @default(ACTIF)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  projectUsers    ProjectUser[]
  createdProjects Project[]     @relation("ProjectCreator")
  approvals       Approval[]

  @@index([organisationId])
  @@map("users")
}

model Role {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @unique
  description String?
  scope       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     ProjectUser[]

  @@map("roles")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  organisationId String        @db.Uuid
  name           String
  code           String
  description    String?
  status         ProjectStatus @default(EN_COURS)
  currency       String?
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  creator        User?         @relation("ProjectCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId      String?       @db.Uuid
  projectUsers   ProjectUser[]
  components     Component[]
  budgets        Budget[]
  ptbaEntries    Ptba[]
  logframeEntries Logframe[]
  risks           Risk[]
  ppmEntries      Ppm[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("projects")
}

model Expense {
  id String @id @default(uuid()) @db.Uuid

  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetId String @db.Uuid

  description String
  amount      Decimal @db.Decimal(18, 2)

  status ExpenseStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals Approval[]

  @@index([budgetId])
  @@map("expenses")
}

model Approval {
  id String @id @default(uuid()) @db.Uuid

  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String  @db.Uuid

  approver   User   @relation(fields: [approverId], references: [id], onDelete: Cascade)
  approverId String @db.Uuid

  level ApprovalLevel

  approved Boolean?

  comment String?

  createdAt DateTime @default(now())

  @@index([expenseId])
  @@index([approverId])
  @@map("approvals")
}

model Ptba {
  id              String      @id @default(uuid()) @db.Uuid

  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String      @db.Uuid

  component       Component?  @relation(fields: [componentId], references: [id], onDelete: SetNull)
  componentId     String?     @db.Uuid

  activity        Activity?   @relation(fields: [activityId], references: [id], onDelete: SetNull)
  activityId      String?     @db.Uuid

  quarter         Quarter

  responsible     String?

  plannedBudget   Decimal     @db.Decimal(18,2)
  actualBudget    Decimal     @default(0) @db.Decimal(18,2)

  description     String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([projectId])
  @@index([componentId])
  @@index([activityId])

  @@map("ptba")
}

model Logframe {
  id                    String         @id @default(uuid()) @db.Uuid

  project               Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId             String         @db.Uuid

  level                 LogframeLevel

  title                 String

  indicator             String?
  baseline              String?
  target                String?

  verificationSource    String?

  assumptions           String?

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([projectId])

  @@map("logframe")
}

model Risk {
  id                 String       @id @default(uuid()) @db.Uuid

  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          String       @db.Uuid

  title              String
  description        String?

  probability        Int
  impact             Int

  criticality        Int

  mitigationMeasure  String?

  owner              String?

  status             RiskStatus   @default(OUVERT)

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([projectId])

  @@map("risks")
}

model Ppm {
  id                String              @id @default(uuid()) @db.Uuid

  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String              @db.Uuid

  title             String

  method            ProcurementMethod

  estimatedAmount   Decimal             @db.Decimal(18,2)

  plannedDate       DateTime?

  actualDate        DateTime?

  responsible       String?

  status            ProcurementStatus   @default(PLANIFIE)

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([projectId])

  @@map("ppm")
}

model ProjectUser {
  id        String   @id @default(uuid()) @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId    String   @db.Uuid
  isOwner   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@map("project_users")
}

model Component {
  id        String  @id @default(uuid()) @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @db.Uuid

  name        String
  description String?

  activities Activity[]
  ptbaEntries Ptba[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("components")
}

model Activity {
  id          String    @id @default(uuid()) @db.Uuid
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  componentId String    @db.Uuid

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ptbaEntries Ptba[]

  @@index([componentId])
  @@map("activities")
}

model Budget {
  id        String  @id @default(uuid()) @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @db.Uuid

  name           String
  amount         Decimal @db.Decimal(18, 2)
  consumedAmount Decimal @default(0) @db.Decimal(18, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]

  @@index([projectId])
  @@map("budgets")
}
